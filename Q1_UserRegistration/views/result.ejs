<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Registration Result</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<main class="container wide">
    <header class="page-heading success-heading">
        <p class="eyebrow">REGISTRATION COMPLETE</p>
        <h1>You're all set, <%= data.username %>.</h1>
        <p class="intro">Your submitted details and images are shown below.</p>
    </header>

    <div class="table-wrap">
        <table class="result-table">
            <tbody>
                <tr><th scope="row">Username</th><td><%= data.username %></td></tr>
                <tr><th scope="row">Email</th><td><%= data.email %></td></tr>
                <tr><th scope="row">Gender</th><td><%= data.gender %></td></tr>
                <tr><th scope="row">Hobbies</th><td><%= data.hobbies.join(", ") %></td></tr>
                <tr><th scope="row">Submitted at</th><td><%= data.submittedAt %></td></tr>
                <tr>
                    <th scope="row">Profile picture</th>
                    <td>
                        <figure class="image-card profile-card">
                            <img src="<%= data.profilePic.url %>" alt="Profile picture for <%= data.username %>">
                            <figcaption><%= data.profilePic.originalName %></figcaption>
                            <a class="image-download" href="/download-image/profile/<%= data.profilePic.fileName %>">Download image</a>
                        </figure>
                    </td>
                </tr>
                <tr>
                    <th scope="row">Other pictures</th>
                    <td>
                        <div class="gallery">
                            <% data.otherPics.forEach((pic, index) => { %>
                                <figure class="image-card">
                                    <img src="<%= pic.url %>" alt="Additional picture <%= index + 1 %>">
                                    <figcaption><%= pic.originalName %></figcaption>
                                    <a class="image-download" href="/download-image/other/<%= pic.fileName %>">Download image</a>
                                </figure>
                            <% }) %>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="actions">
        <a class="button" href="/">Register another user <span aria-hidden="true">→</span></a>
    </div>
</main>
</body>
</html>